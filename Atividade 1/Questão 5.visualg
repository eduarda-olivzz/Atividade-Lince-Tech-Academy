algoritmo "Bhaskara, valores de X"
var 
// determinando variáveis
  a, b, c, delta, x1, x2 : real

inicio
//solicitando valores
  escreval ("Informe o valor de a: ")
  leia (a)
  // A equação só é de 2º grau se 'A' for diferente de zero
		se (a = 0) entao  
			escreva("O valor de A não pode ser zero em uma equação de 2º grau.")
		  interrompa
		fimse
  escreval ("Informe o valor de b: ")
  leia (b)
  escreval ("Informe o valor de c: ")
  leia (c)
  
  delta <- (b*b) - (4 * a * c)

  escreval("Delta = ", delta, "")

	// Analisando a raiz com base no cálculo do Delta
	se (delta < 0) entao
			escreval("A raiz é negativa (Delta negativo).")
  senao 
    x1 <- (-b + exp(delta , 0,5)) / (2 * a)
    x2 <- (-b - exp(delta , 0,5)) / (2 * a)

    escreval (" X1 = ", x1)
    escreval (" X2 = ", x2)
	fimse


fimalgoritmo