algoritmo "Fatorial"
var 
//declarando variáveis
  n1, i, resultado : inteiro
inicio
  escreval ("Informe um valor: ")
  leia (n1)
  // condição para executar o cálculo
  se (n1 < 0) entao
    escreval("ERRO: O número não pode ser negativo.")
    interrompa
  fimse
      resultado <-  1
        para i de n1 ate 1 passo -1 faca
            resultado <- resultado * i
        fimpara
        escreval (" Resultado: ", resultado)
fimalgoritmo
       
